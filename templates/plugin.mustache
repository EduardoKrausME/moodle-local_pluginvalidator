{{!
    @template local_pluginvalidator/plugin

    Example context (json):
    {
    }
}}
<div class="local-pluginvalidator">
    <div class="lpv-back">
        <a href="{{{backurl}}}">&larr; {{#str}}back, local_pluginvalidator{{/str}}</a>
    </div>

    {{#hasnotice}}
        <div class="alert alert-{{noticeclass}}">{{notice}}</div>
    {{/hasnotice}}

    <div class="lpv-plugin-header">
        <div class="lpv-plugin-heading">
            <h2>{{displayname}}</h2>
            <code class="lpv-component">{{component}}</code>
        </div>
        <div class="lpv-plugin-meta">
            {{#release}}
                <div>
                    <span>{{#str}}release, local_pluginvalidator{{/str}}</span>
                    <strong>{{release}}</strong>
                </div>
            {{/release}}
            {{#versiondisk}}
                <div>
                    <span>{{#str}}version, local_pluginvalidator{{/str}}</span>
                    <strong>{{versiondisk}}</strong>
                </div>
            {{/versiondisk}}
        </div>
    </div>

    {{^hasresult}}
        <div class="lpv-section-heading">
            <h3>{{#str}}validations, local_pluginvalidator{{/str}}</h3>
        </div>

        <div class="lpv-engine-list">
            {{#engines}}
                <div class="card lpv-engine-card">
                    <div class="card-body">
                        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
                            <div class="flex-grow-1">
                                <h4 class="h5 mb-1">{{name}}</h4>
                                <p class="text-muted mb-2">{{description}}</p>

                                {{#available}}
                                    <div class="small">
                                        <span class="text-success">
                                            {{#str}}engineavailable, local_pluginvalidator{{/str}}
                                        </span>
                                        {{#version}}
                                            <span class="text-muted ms-2">{{version}} {{source}}</span>
                                        {{/version}}
                                    </div>
                                {{/available}}

                                {{^available}}
                                    <div class="small text-warning">
                                        {{#str}}enginemissing, local_pluginvalidator{{/str}}
                                    </div>
                                {{/available}}
                            </div>

                            <div class="d-flex flex-wrap gap-2">
                                {{#updatable}}
                                    <form method="get" action="{{{actionurl}}}" class="mb-0">
                                        <input type="hidden" name="component" value="{{component}}">
                                        <input type="hidden" name="engine" value="{{id}}">
                                        <input type="hidden" name="action" value="installengine">
                                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                                        <button type="submit" class="btn btn-outline-secondary">
                                            {{#available}}
                                                {{#str}}updateengine, local_pluginvalidator{{/str}}
                                            {{/available}}
                                            {{^available}}
                                                {{#str}}installengine, local_pluginvalidator{{/str}}
                                            {{/available}}
                                        </button>
                                    </form>
                                {{/updatable}}

                                {{#available}}
                                    <form method="get" action="{{{actionurl}}}" class="mb-0">
                                        <input type="hidden" name="component" value="{{component}}">
                                        <input type="hidden" name="engine" value="{{id}}">
                                        <input type="hidden" name="action" value="validate">
                                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                                        <button type="submit" class="btn btn-primary">
                                            {{#str}}runvalidation, local_pluginvalidator{{/str}}
                                        </button>
                                    </form>
                                {{/available}}

                                {{^available}}
                                    <button class="btn btn-primary" disabled>
                                        {{#str}}runvalidation, local_pluginvalidator{{/str}}
                                    </button>
                                {{/available}}
                            </div>
                        </div>
                    </div>
                </div>
            {{/engines}}
        </div>
    {{/hasresult}}

    {{#hasresult}}
        <div class="lpv-result">
            <div class="lpv-result-head {{#resultsuccess}}lpv-result-head--success{{/resultsuccess}}{{^resultsuccess}}lpv-result-head--error{{/resultsuccess}}">
                <div>
                    <div class="lpv-result-kicker">{{#str}}result, local_pluginvalidator{{/str}}</div>
                    <div class="lpv-result-title">
                        {{#resultsuccess}}
                            {{#str}}passed, local_pluginvalidator{{/str}}
                        {{/resultsuccess}}
                        {{^resultsuccess}}
                            {{#str}}failed, local_pluginvalidator{{/str}}
                        {{/resultsuccess}}
                    </div>
                    {{#resultenginename}}
                        <div class="lpv-result-engine">{{resultenginename}}</div>
                    {{/resultenginename}}
                </div>
                <div class="lpv-result-state">
                    {{#resultsuccess}}
                        <span class="lpv-result-state-badge lpv-result-state-badge--success">
                            {{#str}}passed, local_pluginvalidator{{/str}}
                        </span>
                    {{/resultsuccess}}
                    {{^resultsuccess}}
                        <span class="lpv-result-state-badge lpv-result-state-badge--error">
                            {{#str}}failed, local_pluginvalidator{{/str}}
                        </span>
                    {{/resultsuccess}}
                </div>
            </div>

            {{#resultstructured}}
                <div class="lpv-summary">
                    <div class="lpv-summary-card lpv-summary-card--ok">
                        <div class="lpv-summary-value">{{resultok}}</div>
                        <div class="lpv-summary-label">{{#str}}summaryok, local_pluginvalidator{{/str}}</div>
                    </div>
                    <div class="lpv-summary-card lpv-summary-card--warning">
                        <div class="lpv-summary-value">{{resultwarnings}}</div>
                        <div class="lpv-summary-label">
                            {{#str}}summarywarnings, local_pluginvalidator{{/str}}
                        </div>
                    </div>
                    <div class="lpv-summary-card lpv-summary-card--error">
                        <div class="lpv-summary-value">{{resulterrors}}</div>
                        <div class="lpv-summary-label">
                            {{#str}}summaryerrors, local_pluginvalidator{{/str}}
                        </div>
                    </div>
                </div>

                <div class="lpv-execution-summary">
                    {{#resultexecuted}}
                        <span class="lpv-execution-pill lpv-execution-pill--executed">
                            <strong>{{resultexecuted}}</strong>
                            {{#str}}executionstateexecuted, local_pluginvalidator{{/str}}
                        </span>
                    {{/resultexecuted}}
                    {{#resultcontract}}
                        <span class="lpv-execution-pill lpv-execution-pill--contract">
                            <strong>{{resultcontract}}</strong>
                            {{#str}}executionstatecontract, local_pluginvalidator{{/str}}
                        </span>
                    {{/resultcontract}}
                    {{#resultnotapplicable}}
                        <span class="lpv-execution-pill lpv-execution-pill--na">
                            <strong>{{resultnotapplicable}}</strong>
                            {{#str}}executionstatenotapplicable, local_pluginvalidator{{/str}}
                        </span>
                    {{/resultnotapplicable}}
                </div>
            {{/resultstructured}}

            {{#resulttext}}
                {{^resultruntimeerror}}
                    <div class="lpv-text-result">
                        <pre><code>{{resultoutput}}</code></pre>
                    </div>
                {{/resultruntimeerror}}
            {{/resulttext}}
        </div>

        {{#resultruntimeerror}}
            <div class="alert alert-danger lpv-runtime-error">
                <strong>{{#str}}validationruntimeerror, local_pluginvalidator{{/str}}:</strong>
                {{resulterrormessage}}
                {{#hasresulterrordetails}}
                    <details class="lpv-diagnostics">
                        <summary>{{#str}}technicaldetails, local_pluginvalidator{{/str}}</summary>
                        <div class="lpv-diagnostics-body">
                            {{#resulterrordetails}}
                                <div class="lpv-diagnostic-row">
                                    <strong>{{label}}</strong>
                                    <code>{{value}}</code>
                                </div>
                            {{/resulterrordetails}}
                            {{#resulterrortrace}}
                                <div class="lpv-diagnostic-trace">
                                    <strong>{{#str}}stacktrace, local_pluginvalidator{{/str}}</strong>
                                    <pre><code>{{resulterrortrace}}</code></pre>
                                </div>
                            {{/resulterrortrace}}
                        </div>
                    </details>
                {{/hasresulterrordetails}}
            </div>
        {{/resultruntimeerror}}

        {{#resultstructured}}
            <div class="lpv-groups">
                {{#resultgroups}}
                    <section class="lpv-group lpv-group--{{statusclass}}">
                        <div class="lpv-group-header">
                            <div class="lpv-group-title">
                                <code>{{rule}}</code>
                                <span class="lpv-status lpv-status--{{statusclass}}">{{statuslabel}}</span>
                            </div>
                            <div class="lpv-group-summary">
                                {{#summary.ok}}
                                    <span class="lpv-mini-stat lpv-mini-stat--ok">
                                        <strong>{{summary.ok}}</strong>
                                        {{#str}}summaryok, local_pluginvalidator{{/str}}
                                    </span>
                                {{/summary.ok}}
                                {{#summary.warnings}}
                                    <span class="lpv-mini-stat lpv-mini-stat--warning">
                                        <strong>{{summary.warnings}}</strong>
                                        {{#str}}summarywarnings, local_pluginvalidator{{/str}}
                                    </span>
                                {{/summary.warnings}}
                                {{#summary.errors}}
                                    <span class="lpv-mini-stat lpv-mini-stat--error">
                                        <strong>{{summary.errors}}</strong>
                                        {{#str}}summaryerrors, local_pluginvalidator{{/str}}
                                    </span>
                                {{/summary.errors}}
                            </div>
                        </div>

                        <div class="lpv-check-list">
                            {{#checks}}
                                <article class="lpv-check lpv-check--{{statusclass}}">
                                    <div class="lpv-check-status">
                                        <span class="lpv-status lpv-status--{{statusclass}}">{{statuslabel}}</span>
                                        <span class="badge bg-{{executionstateclass}}">
                                            {{executionstatelabel}}
                                        </span>
                                    </div>

                                    <div class="lpv-check-content">
                                        <div class="lpv-check-message">{{message}}</div>

                                        {{#hastechnicaldetails}}
                                            <details class="lpv-diagnostics">
                                                <summary>{{#str}}technicaldetails, local_pluginvalidator{{/str}}</summary>
                                                <div class="lpv-diagnostics-body">
                                                    {{#technicaldetails}}
                                                        <div class="lpv-diagnostic-row">
                                                            <strong>{{label}}</strong>
                                                            <code>{{value}}</code>
                                                        </div>
                                                    {{/technicaldetails}}
                                                    {{#exceptiontrace}}
                                                        <div class="lpv-diagnostic-trace">
                                                            <strong>{{#str}}stacktrace, local_pluginvalidator{{/str}}</strong>
                                                            <pre><code>{{exceptiontrace}}</code></pre>
                                                        </div>
                                                    {{/exceptiontrace}}
                                                </div>
                                            </details>
                                        {{/hastechnicaldetails}}

                                        {{#haslocation}}
                                            <div class="lpv-location">
                                                <code>{{location}}</code>
                                                {{#hastarget}}
                                                    <span aria-hidden="true">&middot;</span>
                                                    <code>{{target}}</code>
                                                {{/hastarget}}
                                            </div>
                                        {{/haslocation}}
                                        {{^haslocation}}
                                            {{#hastarget}}
                                                <div class="lpv-location"><code>{{target}}</code></div>
                                            {{/hastarget}}
                                        {{/haslocation}}
                                    </div>
                                </article>
                            {{/checks}}
                        </div>
                    </section>
                {{/resultgroups}}
            </div>
        {{/resultstructured}}
    {{/hasresult}}
</div>
