{{!
    @template local_pluginvalidator/plugin

    Example context (json):
    {
    }
}}
<div class="local-pluginvalidator">
    <div class="mb-3">
        <a href="{{{backurl}}}">&larr; {{#str}}back, local_pluginvalidator{{/str}}</a>
    </div>

    {{#hasnotice}}
        <div class="alert alert-{{noticeclass}}">{{notice}}</div>
    {{/hasnotice}}

    <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 mb-4">
        <div>
            <h2 class="mb-1">{{displayname}}</h2>
            <div><code>{{component}}</code></div>
        </div>
        <div class="text-lg-end text-muted small">
            {{#release}}<div>{{#str}}release, local_pluginvalidator{{/str}}: {{release}}</div>{{/release}}
            {{#versiondisk}}<div>{{#str}}version, local_pluginvalidator{{/str}}: {{versiondisk}}</div>{{/versiondisk}}
        </div>
    </div>

    {{^hasresult}}
        <h3 class="h4 mb-3">{{#str}}validations, local_pluginvalidator{{/str}}</h3>

        {{#engines}}
            <div class="card mb-3">
                <div class="card-body">
                    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
                        <div class="flex-grow-1">
                            <h4 class="h5 mb-1">{{name}}</h4>
                            <p class="text-muted mb-2">{{description}}</p>

                            {{#available}}
                                <div class="small">
                                    <span class="text-success">{{#str}}engineavailable, local_pluginvalidator{{/str}}</span>
                                    {{#version}}<span class="text-muted ms-2">{{version}} {{source}}</span>{{/version}}
                                </div>
                            {{/available}}

                            {{^available}}
                                <div class="small text-warning">
                                    {{#str}}enginemissing, local_pluginvalidator{{/str}}
                                </div>
                            {{/available}}
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <form method="get" action="{{{actionurl}}}" class="mb-0">
                                <input type="hidden" name="component" value="{{component}}">
                                <input type="hidden" name="engine" value="{{id}}">
                                <input type="hidden" name="action" value="installengine">
                                <input type="hidden" name="sesskey" value="{{sesskey}}">
                                <button type="submit" class="btn btn-outline-secondary">
                                    {{#available}}{{#str}}updateengine, local_pluginvalidator{{/str}}{{/available}}
                                    {{^available}}{{#str}}installengine, local_pluginvalidator{{/str}}{{/available}}
                                </button>
                            </form>

                            {{#available}}
                                <form method="get" action="{{{actionurl}}}" class="mb-0">
                                    <input type="hidden" name="component" value="{{component}}">
                                    <input type="hidden" name="engine" value="{{id}}">
                                    <input type="hidden" name="action" value="validate">
                                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                                    <button type="submit" class="btn btn-primary">
                                        {{#str}}runvalidation, local_pluginvalidator{{/str}}
                                    </button>
                                </form>
                            {{/available}}

                            {{^available}}
                                <button class="btn btn-primary" disabled>
                                    {{#str}}runvalidation, local_pluginvalidator{{/str}}
                                </button>
                            {{/available}}
                        </div>
                    </div>
                </div>
            </div>
        {{/engines}}
    {{/hasresult}}

    {{#hasresult}}
        <div class="card mb-4">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <strong>{{#str}}result, local_pluginvalidator{{/str}}</strong>
                    {{#resultenginename}}
                        <span class="text-muted ms-2">{{resultenginename}}</span>
                    {{/resultenginename}}
                </div>
                {{#resultsuccess}}
                    <span class="badge bg-success">{{#str}}passed, local_pluginvalidator{{/str}}</span>
                {{/resultsuccess}}
                {{^resultsuccess}}
                    <span class="badge bg-danger">{{#str}}failed, local_pluginvalidator{{/str}}</span>
                {{/resultsuccess}}
            </div>

            {{#resultstructured}}
                <div class="card-body">
                    <div class="d-flex flex-wrap gap-2">
                        <span class="badge bg-success">
                            {{resultok}} {{#str}}summaryok, local_pluginvalidator{{/str}}
                        </span>
                        <span class="badge bg-warning text-dark">
                            {{resultwarnings}} {{#str}}summarywarnings, local_pluginvalidator{{/str}}
                        </span>
                        <span class="badge bg-danger">
                            {{resulterrors}} {{#str}}summaryerrors, local_pluginvalidator{{/str}}
                        </span>
                    </div>
                </div>
            {{/resultstructured}}

            {{#resulttext}}
                {{^resultruntimeerror}}
                    <div class="card-body">
                        <pre class="bg-light border rounded p-3 mb-0 overflow-auto"><code>{{resultoutput}}</code></pre>
                    </div>
                {{/resultruntimeerror}}
            {{/resulttext}}
        </div>

        {{#resultruntimeerror}}
            <div class="alert alert-danger">
                <strong>{{#str}}validationruntimeerror, local_pluginvalidator{{/str}}:</strong>
                {{resulterrormessage}}
            </div>
        {{/resultruntimeerror}}

        {{#resultstructured}}
            {{#resultgroups}}
                <div class="card mb-3 border-{{statusclass}}">
                    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <code class="fs-6">{{rule}}</code>
                            <span class="badge bg-{{statusclass}}">{{statuslabel}}</span>
                        </div>
                        <div class="d-flex flex-wrap gap-2 small">
                            {{#summary.ok}}
                                <span class="text-success">{{summary.ok}} {{#str}}summaryok, local_pluginvalidator{{/str}}</span>
                            {{/summary.ok}}
                            {{#summary.warnings}}
                                <span class="text-warning">{{summary.warnings}} {{#str}}summarywarnings, local_pluginvalidator{{/str}}</span>
                            {{/summary.warnings}}
                            {{#summary.errors}}
                                <span class="text-danger">{{summary.errors}} {{#str}}summaryerrors, local_pluginvalidator{{/str}}</span>
                            {{/summary.errors}}
                        </div>
                    </div>

                    <div class="list-group list-group-flush">
                        {{#checks}}
                            <div class="list-group-item">
                                <div class="d-flex flex-column flex-md-row align-items-md-start gap-2">
                                    <div class="flex-shrink-0">
                                        <span class="badge bg-{{statusclass}}">{{statuslabel}}</span>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div>{{message}}</div>

                                        {{#explanation}}
                                            <div class="mt-2">
                                                <strong>{{#str}}whythishappened, local_pluginvalidator{{/str}}:</strong>
                                                <div class="text-muted">{{explanation}}</div>
                                            </div>
                                        {{/explanation}}

                                        {{#howToFix}}
                                            <div class="mt-2">
                                                <strong>{{#str}}howtofix, local_pluginvalidator{{/str}}:</strong>
                                                <div class="text-muted">{{howToFix}}</div>
                                            </div>
                                        {{/howToFix}}

                                        {{#haslocation}}
                                            <div class="small text-muted mt-1">
                                                <code>{{location}}</code>
                                                {{#hastarget}}
                                                    <span class="mx-1">&middot;</span>
                                                    <code>{{target}}</code>
                                                {{/hastarget}}
                                            </div>
                                        {{/haslocation}}
                                        {{^haslocation}}
                                            {{#hastarget}}
                                                <div class="small text-muted mt-1"><code>{{target}}</code></div>
                                            {{/hastarget}}
                                        {{/haslocation}}
                                    </div>
                                </div>
                            </div>
                        {{/checks}}
                    </div>
                </div>
            {{/resultgroups}}
        {{/resultstructured}}
    {{/hasresult}}
</div>
